# PostgreSQL lokal
POSTGRES_DB=plts
POSTGRES_USER=plts
POSTGRES_PASSWORD=ganti-password-lokal
DATABASE_URL=postgresql+asyncpg://plts:ganti-password-lokal@postgres:5432/plts

# Aplikasi
APP_NAME=PLTS Monitor Rumah
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEVICE_SLUG=prime-rumah-01
DEVICE_NAME=PLTS Rumah
DEVICE_API_KEY=ganti-dengan-kunci-acak-panjang
TARIFF_IDR_PER_KWH=1550
ONLINE_AFTER_SECONDS=30
DEGRADED_AFTER_SECONDS=120
MAX_INTEGRATION_GAP_SECONDS=60

# Next.js server -> FastAPI. Browser tidak memakai alamat ini langsung.
INTERNAL_API_BASE_URL=http://api:8000

# Opsional, untuk profil Cloudflare Compose
CLOUDFLARE_TUNNEL_TOKEN=


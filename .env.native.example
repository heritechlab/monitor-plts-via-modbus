# Mode native paling ringan: tidak membutuhkan Docker atau PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/plts.sqlite3
APP_NAME=PLTS Monitor Rumah
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEVICE_SLUG=prime-rumah-01

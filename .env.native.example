DEVICE_API_KEY=ganti-dengan-kunci-acak-panjang
TARIFF_IDR_PER_KWH=1550
AUTO_BOOTSTRAP_DEVICE=true
INTERNAL_API_BASE_URL=http://127.0.0.1:8000


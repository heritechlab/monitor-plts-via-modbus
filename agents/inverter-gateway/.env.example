DEVICE_SLUG=prime-rumah-01
DEVICE_API_KEY=ganti-dengan-nilai-yang-sama-seperti-root-env
API_BASE_URL=http://127.0.0.1:8000
# "auto" hanya aman kalau CH340 yang terdeteksi PERSIS SATU. Begitu ada adaptor
# CH340 kedua di laptop ini (mis. dongle BMS di agents/bms-gateway), auto gagal
# dengan "Lebih dari satu adaptor CH340 terdeteksi" — tetapkan COM port eksplisit.
SERIAL_PORT=COM3
SERIAL_BAUD=9600
SLAVE_ID=1
POLL_INTERVAL_SECONDS=5
# Blok setelan (0x4000) dipoll jauh lebih jarang -- setelan nyaris tak pernah
# berubah, tidak perlu cadence sama dengan telemetri.
SETTINGS_POLL_INTERVAL_SECONDS=300
SERIAL_TIMEOUT_SECONDS=2
HTTP_TIMEOUT_SECONDS=10
UPLOAD_BATCH_SIZE=100
HEARTBEAT_INTERVAL_SECONDS=30
QUEUE_DB_PATH=./data/offline_queue.sqlite3
CSV_BACKUP_DIR=./data/csv
GATEWAY_LOG_FILE=./data/gateway.log
GATEWAY_VERSION=0.1.0
TIMEZONE=Asia/Jakarta
VERIFY_TLS=true

DEVICE_SLUG=prime-rumah-01-bms
DEVICE_API_KEY=ganti-dengan-nilai-yang-sama-seperti-root-env
API_BASE_URL=http://127.0.0.1:8000
# WAJIB eksplisit (bukan "auto"): laptop ini punya 2 adaptor CH340 (inverter + BMS).
# "auto" hanya aman kalau CH340 yang terdeteksi persis satu.
SERIAL_PORT=COM6
SERIAL_BAUD=115200
SLAVE_ID=1
POLL_INTERVAL_SECONDS=5
SERIAL_TIMEOUT_SECONDS=2
HTTP_TIMEOUT_SECONDS=10
UPLOAD_BATCH_SIZE=100
HEARTBEAT_INTERVAL_SECONDS=30
QUEUE_DB_PATH=./data/offline_queue.sqlite3
CSV_BACKUP_DIR=./data/csv
GATEWAY_LOG_FILE=./data/gateway.log
GATEWAY_VERSION=0.1.0
TIMEZONE=Asia/Jakarta
VERIFY_TLS=true
